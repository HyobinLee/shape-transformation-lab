# 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml 은 .gitignore 에 들어 있으므로 커밋되지 않습니다. 절대 키를
# 저장소에 올리지 마세요.
#
# 이 키가 **없어도 앱은 정상 동작합니다.** §1 단계별 탐구의 챗봇이 규칙 기반
# 폴백으로 내려갈 뿐이고, 학생의 발견을 판정하는 일은 어차피 코드가 하므로
# 수업이 반쪽이 되지는 않습니다.

GEMINI_API_KEY = "여기에 키"
GEMINI_MODEL = "gemini-3.5-flash"
